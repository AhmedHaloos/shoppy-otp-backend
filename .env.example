# Firebase Admin SDK service account. Two ways to set this -- prefer the
# base64 one on any hosting provider's web-based env-var editor: several
# (confirmed on Vercel) mangle the private_key field's escaped \n
# newlines when the raw JSON below is pasted in directly, breaking the
# PEM. Base64 has no characters those UIs could misinterpret.
#
# Preferred: FIREBASE_SERVICE_ACCOUNT_BASE64 -- the whole JSON file,
# base64-encoded as one line. Generate it locally with:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('service-account.json')).toString('base64'))"
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...
#
# Fallback (fine for local .env, avoid on hosted env-var UIs):
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
# Paste the ENTIRE contents of the downloaded JSON file here as one line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"blog-56c04",...}

# Gmail address used to send OTP emails.
GMAIL_USER=your-sending-address@gmail.com

# Gmail App Password (NOT your normal Gmail password).
# Requires 2-Step Verification enabled on the account:
# Google Account -> Security -> App passwords -> generate one for "Mail".
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# A random long string used to "pepper" OTP code hashes before storing
# them in Firestore, so a raw Firestore export alone can't be used to
# recover valid codes. Generate any long random string for this.
OTP_HASH_PEPPER=change-this-to-a-long-random-string

# Optional -- only needed for local runs (`npm start`). Not used on
# Vercel, which runs this as a serverless function instead of a
# listening server.
PORT=3000
